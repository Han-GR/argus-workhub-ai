# 复制为 docker/.env，替换密码与密钥。该文件不应提交真实凭据。
# MySQL、Redis 由 Compose 创建，后端通过服务名连接，无需填写地址。
# 必须与本地 publish.sh 已发布的版本一致。
IMAGE_TAG=20261114-1
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
DATABASE_USER=argus
DATABASE_PASSWORD=change-me-mysql-password
DATABASE_NAME=argus
REDIS_PASSWORD=change-me-redis-password
REDIS_DB_NAME=1
# 使用 openssl rand -hex 32 生成。部署后保持不变。
SECRET_KEY=change-me-to-a-long-random-secret
DATA_ENCRYPTION_KEY=
DEMO_ENABLE=false
HTTP_PORT=80
HTTPS_PORT=443

# AI 功能可在这里设置默认模型，也可登录后在模型设置中配置。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
