# 复制为 docker/.env，填写现有服务连接信息。该文件不应提交真实凭据。
# 容器中的 localhost 不是宿主机；同机服务可使用 host.docker.internal。
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
DATABASE_USER=argus
DATABASE_PASSWORD=change-me-mysql-password
DATABASE_NAME=argus
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB_NAME=1
# 使用 openssl rand -hex 32 生成。部署后保持不变。
SECRET_KEY=change-me-to-a-long-random-secret
DATA_ENCRYPTION_KEY=
DEMO_ENABLE=false
BACKEND_PORT=8001
HTTP_PORT=80
HTTPS_PORT=443

# AI 功能可在这里设置默认模型，也可登录后在模型设置中配置。
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
